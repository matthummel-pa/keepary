# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon / public key — safe for the browser. NEVER use the service-role key here.
VITE_SUPABASE_KEY=your-anon-public-key

# The email address treated as the app owner / super-admin.
VITE_OWNER_EMAIL=you@example.com
